---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getBookManifests, getBookUnits, getSourceRevision, type BookManifest } from "../../../lib/book";

export function getStaticPaths() {
  return getBookManifests().map((book) => ({ params: { book: book.slug }, props: { book } }));
}

interface Props { book: BookManifest }
const { book } = Astro.props;
const units = getBookUnits(book.slug);
const first = units[0];
const sourceRevision = getSourceRevision(book.slug);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const bookUrl = new URL(`${base}/books/${book.slug}/`, Astro.site).href;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Book",
  name: book.title,
  alternateName: book.subtitle,
  description: book.description,
  author: { "@type": "Organization", name: book.author },
  inLanguage: ["en", "zh-Hant"],
  bookEdition: book.publication.version,
  dateModified: book.publication.updated,
  url: bookUrl,
};
---
<BaseLayout title={`${book.title}｜OceanAI Books`} description={book.description} structuredData={structuredData}>
  <section class="book-hero shell">
    <aside class="book-register" aria-label="書籍出版資訊">
      <p aria-hidden="true">================================================</p>
      <dl>
        <div><dt><span data-language="en">CLASSIFICATION</span><span data-language="zh">文件分級</span></dt><dd><span data-language="en">UNRESTRICTED DISTRIBUTION</span><span data-language="zh">公開發行</span></dd></div>
        <div><dt><span data-language="en">REGISTER</span><span data-language="zh">登錄類型</span></dt><dd><span data-language="en">OCEANAI BOOK / RAW DIGITAL EDITION</span><span data-language="zh">OceanAI 書籍 / 原始數位版本</span></dd></div>
        <div><dt><span data-language="en">STATUS</span><span data-language="zh">狀態</span></dt><dd><span data-language="en">{book.publication.statusLabelEn} / OPEN ACCESS</span><span data-language="zh">{book.publication.statusLabel} / 開放閱讀</span></dd></div>
        <div><dt><span data-language="en">DATE</span><span data-language="zh">更新日期</span></dt><dd><time datetime={book.publication.updated}>{book.publication.updated}</time></dd></div>
        <div><dt><span data-language="en">LANGUAGE</span><span data-language="zh">語言</span></dt><dd>{book.languageLabel}</dd></div>
        <div><dt><span data-language="en">STRUCTURE</span><span data-language="zh">結構</span></dt><dd>{book.partCount} <span data-language="en">PARTS / {units.length} READING UNITS</span><span data-language="zh">部 / {units.length} 個閱讀單元</span></dd></div>
        <div><dt><span data-language="en">VERSION</span><span data-language="zh">版本</span></dt><dd>{book.publication.version}{sourceRevision && <> / <code>{sourceRevision.revision.slice(0, 12)}</code></>}</dd></div>
      </dl>
      <p aria-hidden="true">================================================</p>
    </aside>
    <div class="book-manifest">
      <p class="eyebrow">OCEANAI BOOK · <span data-language="en">{book.publication.statusLabelEn}</span><span data-language="zh">{book.publication.statusLabel}</span></p>
      <h1><span lang="en" data-language="en">THE OCEAN OF<br />INTELLIGENCE<br />—</span><span lang="zh-Hant" data-language="zh">智慧之海<br />—</span></h1>
      <p class="book-subtitle"><span lang="en" data-language="en">{book.subtitleEn}</span><span lang="zh-Hant" data-language="zh">{book.subtitle}</span></p>
      <p class="book-author">{book.author}</p>
    </div>
  </section>
  <section class="book-actions shell" aria-label="開始閱讀">
    <div class="book-action-cell"><p class="eyebrow"><span data-language="en">01. START THE BOOK</span><span data-language="zh">01. 開始閱讀本書</span></p><a class="primary-link" href={`${base}/books/${book.slug}/read/${first.slug}/`}><span data-language="en">START READING</span><span data-language="zh">開始閱讀</span><span>→</span></a></div>
    <div class="book-action-cell"><p class="eyebrow"><span data-language="en">02. EXPLORE THE WORK</span><span data-language="zh">02. 瀏覽全書結構</span></p><a class="secondary-link" href={`${base}/books/${book.slug}/contents/`}><span data-language="en">VIEW FULL CONTENTS</span><span data-language="zh">查看完整目錄</span><span>↗</span></a></div>
    <div class="book-action-cell"><p class="eyebrow"><span data-language="en">03. RETURN TO THE TEXT</span><span data-language="zh">03. 返回閱讀位置</span></p><a class="secondary-link" href={`${base}/books/${book.slug}/read/${first.slug}/`} data-continue-book={book.slug}><span data-language="en">CONTINUE READING</span><span data-language="zh">繼續閱讀</span><span>→</span></a></div>
  </section>
  <section class="book-statement shell">
    <p class="eyebrow"><span data-language="en">CORE PROPOSITION</span><span data-language="zh">本書核心觀點</span></p>
    <div class="book-statement-copy">
      <p><span data-language="en">Intelligence is not an accumulation of isolated capabilities, but an order gradually formed through relation, responsibility, trust, and system coordination.</span><span data-language="zh">智慧不是孤立能力的累積，而是關係、責任、信任與系統協同逐步形成的秩序。</span></p>
      <p><span data-language="en">When artificial intelligence enters devices, spaces, and continuously operating systems, it is no longer only a model or a tool. It becomes distributed system intelligence and spatial intelligence. The architecture of intelligence must therefore encompass both technical capability and ethical responsibility.</span><span data-language="zh">當人工智慧進入設備、空間與持續運行的系統，它便不再只是模型或工具，而成為分布式的系統智能與空間智能。智慧的架構，因此必須同時包含技術能力與倫理責任。</span></p>
      <p><span data-language="en">This book asks not only how capable AI can become, but what kind of intelligence deserves to be built, trusted, and sustained—and how humans and machines might together form the next order of civilization.</span><span data-language="zh">本書真正追問的，不只是人工智慧能變得多強，而是什麼樣的智慧值得被建立、信任並延續，以及人與機器如何共同形成下一種文明秩序。</span></p>
    </div>
  </section>
  <section class="book-related-links shell" aria-label="延伸閱讀">
    <article>
      <h2>01. <span data-language="en">THE PREFACE</span><span data-language="zh">前言</span> <small><span data-language="en">↳ [ ENTER THE EDITION ]</span><span data-language="zh">↳ [ 進入本版序言 ]</span></small></h2>
      <p><span data-language="en">Why this book was written, the question from which it begins, and the publishing intention behind this continuously revised edition.</span><span data-language="zh">理解這本書為何而寫、它從什麼問題出發，以及這部持續修訂版本背後的出版意圖。</span></p>
      <a href={`${base}/books/${book.slug}/read/preface/`}><span data-language="en">[ READ THE PREFACE ]</span><span data-language="zh">[ 閱讀前言 ]</span></a>
      <span class="book-related-arrow" aria-hidden="true">→</span>
    </article>
    <article>
      <h2>02. <span data-language="en">HOW TO READ THIS BOOK</span><span data-language="zh">如何閱讀本書</span> <small><span data-language="en">↳ [ NAVIGATE THE EDITION ]</span><span data-language="zh">↳ [ 掌握閱讀方式 ]</span></small></h2>
      <p><span data-language="en">The book moves from individual intelligence through system architecture and human–AI ethics toward a civilization of collective intelligence. Read it in sequence or enter through any Part; choose EN, Traditional Chinese, or the bilingual edition at any time.</span><span data-language="zh">全書從個體智慧、系統架構與人機倫理，逐步走向共智文明。你可以依序閱讀，也可以從任何 Part 進入；並可隨時切換英文、繁中或英中並列版本。</span></p>
      <a href={`${base}/books/${book.slug}/read/chapter-1/`}><span data-language="en">[ BEGIN READING ]</span><span data-language="zh">[ 開始閱讀 ]</span></a>
      <span class="book-related-arrow" aria-hidden="true">→</span>
    </article>
    <article>
      <h2>03. <span data-language="en">EDITION &amp; SOURCE</span><span data-language="zh">版本與內容源</span> <small><span data-language="en">↳ [ CONTINUOUS PUBLICATION ]</span><span data-language="zh">↳ [ 持續出版說明 ]</span></small></h2>
      <p><span data-language="en">This is an open digital edition under continuous revision. GitHub is the authoritative manuscript source; the version and update date shown above identify the edition you are reading and citing.</span><span data-language="zh">這是一部持續修訂的公開數位版本。GitHub 是權威書稿來源；上方顯示的版本與更新日期，用於辨識你正在閱讀與引用的版本。</span></p>
      <a href={book.source.repository.replace(/\.git$/, "")}><span data-language="en">[ VIEW SOURCE MANUSCRIPT ]</span><span data-language="zh">[ 查看 GITHUB 原始書稿 ]</span></a>
      <span class="book-related-arrow" aria-hidden="true">↗</span>
    </article>
  </section>
</BaseLayout>
