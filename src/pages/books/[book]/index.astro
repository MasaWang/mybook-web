---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BookLanding from "../../../components/BookLanding.astro";
import { getBookManifests, getBookUnits, getSourceRevision, publicationGraph, type BookManifest } from "../../../lib/book";

export function getStaticPaths() {
  return getBookManifests().map((book) => ({ params: { book: book.slug }, props: { book } }));
}

interface Props { book: BookManifest }
const { book } = Astro.props;
const units = getBookUnits(book.slug);
const sourceRevision = getSourceRevision(book.slug);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const bookUrl = new URL(`${base}/books/${book.slug}/`, Astro.site).href;
const image = new URL(`${base}/og-default.svg`, Astro.site).href;
const structuredData = publicationGraph({
  book,
  bookUrl,
  page: {
    name: `${book.title} — OceanAI Raw Markdown`,
    description: book.description,
    url: bookUrl,
  },
  image,
});
---
<BaseLayout
  title={`${book.title} — OceanAI Raw Markdown`}
  description={book.description}
  structuredData={structuredData}
>
  <BookLanding book={book} units={units} sourceRevision={sourceRevision} />
</BaseLayout>
