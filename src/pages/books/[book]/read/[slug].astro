---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { getBookManifests, getBookUnits, type BookManifest, type ReadingUnit } from "../../../../lib/book";

export function getStaticPaths() {
  return getBookManifests().flatMap((book) => {
    const units = getBookUnits(book.slug);
    return units.map((unit, index) => ({
      params: { book: book.slug, slug: unit.slug },
      props: { book, unit, previous: units[index - 1], next: units[index + 1], index, total: units.length },
    }));
  });
}

interface Props { book: BookManifest; unit: ReadingUnit; previous?: ReadingUnit; next?: ReadingUnit; index: number; total: number }
const { book, unit, previous, next, index, total } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const chapterUrl = new URL(`${base}/books/${book.slug}/read/${unit.slug}/`, Astro.site).href;
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Chapter",
    name: unit.title,
    position: index + 1,
    inLanguage: unit.hasBilingualContent ? ["en", "zh-Hant"] : "zh-Hant",
    dateModified: book.publication.updated,
    url: chapterUrl,
    isPartOf: { "@type": "Book", name: book.title, url: new URL(`${base}/books/${book.slug}/`, Astro.site).href },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: book.title, item: new URL(`${base}/books/${book.slug}/`, Astro.site).href },
      { "@type": "ListItem", position: 2, name: "目錄", item: new URL(`${base}/books/${book.slug}/contents/`, Astro.site).href },
      { "@type": "ListItem", position: 3, name: unit.title, item: chapterUrl },
    ],
  },
];
const alternateLanguages = unit.hasBilingualContent ? [
  { hrefLang: "en", href: `${chapterUrl}?lang=en` },
  { hrefLang: "zh-Hant", href: `${chapterUrl}?lang=zh` },
  { hrefLang: "x-default", href: chapterUrl },
] : [];
const [displayTitleEn, displayTitleZh] = unit.title.split("｜").map((title) => title.trim());
const compactTitle = displayTitleEn.match(/^Chapter\s+\d+/)?.[0] ?? unit.label ?? displayTitleEn;
---
<BaseLayout title={`${unit.title}｜${book.title}`} description={`${book.title} ${unit.part}：${unit.title}`} structuredData={structuredData} alternateLanguages={alternateLanguages}>
  <article class="reader shell" data-book={book.slug} data-unit={unit.slug} data-default-mode={book.defaultReadingMode}>
    <nav class="breadcrumbs" aria-label="麵包屑"><a href={`${base}/books/${book.slug}/`}>{book.title}</a><span>/</span><a href={`${base}/books/${book.slug}/contents/`}>目錄</a><span>/</span><span class="breadcrumb-title" aria-current="page"><span class="breadcrumb-title-full">{unit.title}</span><span class="breadcrumb-title-compact">{compactTitle}</span></span></nav>
    <header class="reader-header">
      <p class="eyebrow">{unit.part} · 約 {unit.minutes} 分鐘</p>
      <h1 class:list={{ "bilingual-title": displayTitleZh }}><span>{displayTitleEn}</span>{displayTitleZh && <span lang="zh-Hant">{displayTitleZh}</span>}</h1>
      <p class="publication-note"><span>{book.publication.status}</span> · Updated <time datetime={book.publication.updated}>{book.publication.updated}</time></p>
    </header>
    <div class="reading-progress" aria-label={`閱讀單元 ${index + 1}，共 ${total} 個`}><span style={`width:${((index + 1) / total) * 100}%`}></span></div>
    {unit.hasBilingualContent && (
      <nav class="language-switcher" aria-label="閱讀語言">
        <button type="button" data-mode="en" aria-pressed="false">EN</button>
        <button type="button" data-mode="zh" aria-pressed="false">繁中</button>
        <button type="button" data-mode="bilingual" aria-pressed="true">EN + 繁中</button>
      </nav>
    )}
    <div class="reading-layout">
      <details class="reader-toc" open>
        <summary>本書目錄</summary>
        <nav aria-label="書籍目錄">
          {getBookUnits(book.slug).map((item) => (
            <a href={`${base}/books/${book.slug}/read/${item.slug}/`} aria-current={item.slug === unit.slug ? "page" : undefined}>
              <small>{item.part}</small><span>{item.title}</span>
            </a>
          ))}
        </nav>
      </details>
      <div class="prose">
        {unit.content.introHtml && <section class="prose-intro" set:html={unit.content.introHtml} />}
        {unit.content.enHtml && <section lang="en" data-language="en" set:html={unit.content.enHtml} />}
        {unit.content.zhHtml && <section lang="zh-Hant" data-language="zh" set:html={unit.content.zhHtml} />}
      </div>
    </div>
    <nav class="chapter-nav" aria-label="章節導覽">
      <div>{previous && <a href={`${base}/books/${book.slug}/read/${previous.slug}/`}><small>← 上一篇</small><strong>{previous.title}</strong></a>}</div>
      <div>{next && <a href={`${base}/books/${book.slug}/read/${next.slug}/`}><small>下一篇 →</small><strong>{next.title}</strong></a>}</div>
    </nav>
  </article>
  <script>
    const article = document.querySelector<HTMLElement>("[data-book][data-unit]");
    const buttons = [...document.querySelectorAll<HTMLButtonElement>("[data-mode]")];
    if (article) {
      const positionKey = `oceanai-reading:${article.dataset.book}`;
      const modeKey = `oceanai-reading-mode:${article.dataset.book}`;
      const supportedModes = new Set(["en", "zh", "bilingual"]);
      const requestedMode = new URLSearchParams(location.search).get("lang");
      const savedMode = localStorage.getItem(modeKey);
      const mode = requestedMode && supportedModes.has(requestedMode) ? requestedMode : savedMode && supportedModes.has(savedMode) ? savedMode : article.dataset.defaultMode ?? "bilingual";
      const setMode = (nextMode: string) => {
        document.documentElement.dataset.readingMode = nextMode;
        buttons.forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.mode === nextMode)));
        localStorage.setItem(modeKey, nextMode);
      };
      setMode(mode);
      buttons.forEach((button) => button.addEventListener("click", () => setMode(button.dataset.mode ?? "bilingual")));
      let savedPosition: { unit?: string; scrollY?: number } | undefined;
      try { savedPosition = JSON.parse(localStorage.getItem(positionKey) ?? "null") ?? undefined; } catch {}
      const savedScrollY = savedPosition?.scrollY;
      if (savedPosition?.unit === article.dataset.unit && savedScrollY && !location.hash) scrollTo(0, savedScrollY);
      let savePending = false;
      const savePosition = () => {
        localStorage.setItem(positionKey, JSON.stringify({ unit: article.dataset.unit, path: location.pathname, scrollY, updatedAt: Date.now() }));
        savePending = false;
      };
      savePosition();
      addEventListener("scroll", () => {
        if (!savePending) { savePending = true; requestAnimationFrame(savePosition); }
      }, { passive: true });
      const toc = document.querySelector<HTMLDetailsElement>(".reader-toc");
      if (toc && matchMedia("(max-width: 56rem)").matches) toc.open = false;
    }
  </script>
</BaseLayout>
