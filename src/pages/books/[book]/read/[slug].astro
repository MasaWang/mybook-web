---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { getBookManifests, getBookUnits, splitBilingualLabel, type BookManifest, type ReadingUnit } from "../../../../lib/book";

export function getStaticPaths() {
  return getBookManifests().flatMap((book) => {
    const units = getBookUnits(book.slug);
    return units.map((unit, index) => ({
      params: { book: book.slug, slug: unit.slug },
      props: { book, unit, previous: units[index - 1], next: units[index + 1], index, total: units.length },
    }));
  });
}

interface Props { book: BookManifest; unit: ReadingUnit; previous?: ReadingUnit; next?: ReadingUnit; index: number; total: number }
const { book, unit, previous, next, index, total } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const chapterUrl = new URL(`${base}/books/${book.slug}/read/${unit.slug}/`, Astro.site).href;
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Chapter",
    name: unit.title,
    position: index + 1,
    inLanguage: unit.hasBilingualContent ? ["en", "zh-Hant"] : "zh-Hant",
    dateModified: book.publication.updated,
    url: chapterUrl,
    isPartOf: { "@type": "Book", name: book.title, url: new URL(`${base}/books/${book.slug}/`, Astro.site).href },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: book.title, item: new URL(`${base}/books/${book.slug}/`, Astro.site).href },
      { "@type": "ListItem", position: 2, name: "目錄", item: new URL(`${base}/books/${book.slug}/contents/`, Astro.site).href },
      { "@type": "ListItem", position: 3, name: unit.title, item: chapterUrl },
    ],
  },
];
const alternateLanguages = unit.hasBilingualContent ? [
  { hrefLang: "en", href: `${chapterUrl}?lang=en` },
  { hrefLang: "zh-Hant", href: `${chapterUrl}?lang=zh` },
  { hrefLang: "x-default", href: chapterUrl },
] : [];
const { en: displayTitleEn, zh: displayTitleZh } = splitBilingualLabel(unit.title);
const localizedTitleZh = displayTitleZh || (unit.slug === "preface" ? "前言" : "");
const compactTitle = displayTitleEn.match(/^Chapter\s+\d+/)?.[0] ?? unit.label ?? displayTitleEn;
const displayPart = splitBilingualLabel(unit.part);
const previousTitle = previous ? splitBilingualLabel(previous.title) : undefined;
const nextTitle = next ? splitBilingualLabel(next.title) : undefined;
---
<BaseLayout title={`${unit.title}｜${book.title}`} description={`${book.title} ${unit.part}：${unit.title}`} structuredData={structuredData} alternateLanguages={alternateLanguages}>
  <article class="reader shell" data-book={book.slug} data-unit={unit.slug} data-default-mode={book.defaultReadingMode}>
    <nav class="breadcrumbs" aria-label="Breadcrumb / 麵包屑"><a href={`${base}/books/${book.slug}/`}><span data-language="en">{book.titleEn}</span><span data-language="zh">{book.title}</span></a><span>/</span><a href={`${base}/books/${book.slug}/contents/`}><span data-language="en">CONTENTS</span><span data-language="zh">目錄</span></a><span>/</span><span class="breadcrumb-title" aria-current="page"><span class="breadcrumb-title-full"><span data-language="en">{displayTitleEn}</span>{localizedTitleZh && <span data-language="zh">{localizedTitleZh}</span>}</span><span class="breadcrumb-title-compact">{compactTitle}</span></span></nav>
    <header class="reader-header">
      <div class="reader-register">
        <p class="eyebrow">
          {unit.slug === "preface" ? <><span data-language="en">FRONT MATTER</span><span data-language="zh">書首</span></> : <><span data-language="en">RAW READING FILE</span><span data-language="zh">原始閱讀檔案</span> · <span data-language="en">{displayPart.en}</span>{displayPart.zh && <span data-language="zh">{displayPart.zh}</span>}</>}
        </p>
        <p><span data-language="en">UNIT</span><span data-language="zh">單元</span> {String(index + 1).padStart(2, "0")} / {String(total).padStart(2, "0")} · {unit.minutes} <span data-language="en">MIN READ</span><span data-language="zh">分鐘閱讀</span></p>
        <p class="publication-note"><span><span data-language="en">{book.publication.status}</span><span data-language="zh">{book.publication.statusLabel}</span></span> · <span data-language="en">UPDATED</span><span data-language="zh">更新</span> <time datetime={book.publication.updated}>{book.publication.updated}</time></p>
      </div>
      <h1 class:list={{ "bilingual-title": localizedTitleZh }}>
        <span class="title-en" lang="en" data-language="en">{displayTitleEn}</span>
        {localizedTitleZh && <span class="title-zh" lang="zh-Hant" data-language="zh">{localizedTitleZh}</span>}
      </h1>
    </header>
    <div class="reading-progress" aria-label={`閱讀單元 ${index + 1}，共 ${total} 個`}><span style={`width:${((index + 1) / total) * 100}%`}></span></div>
    <div class="reading-layout">
      <div class="prose">
        {unit.content.introHtml && <section class="prose-intro" data-language={unit.hasBilingualContent ? "en" : undefined} set:html={unit.content.introHtml} />}
        {unit.content.enHtml && <section lang="en" data-language="en" set:html={unit.content.enHtml} />}
        {unit.content.zhHtml && <section lang="zh-Hant" data-language="zh" set:html={unit.content.zhHtml} />}
      </div>
    </div>
    <nav class="chapter-nav" aria-label="章節導覽">
      <div>{previous && previousTitle && <a href={`${base}/books/${book.slug}/read/${previous.slug}/`}><small><span data-language="en">← PREVIOUS</span><span data-language="zh">← 上一篇</span></small><strong><span data-language="en">{previousTitle.en}</span>{previousTitle.zh && <span data-language="zh">{previousTitle.zh}</span>}</strong></a>}</div>
      <div>{next && nextTitle && <a href={`${base}/books/${book.slug}/read/${next.slug}/`}><small><span data-language="en">NEXT →</span><span data-language="zh">下一篇 →</span></small><strong><span data-language="en">{nextTitle.en}</span>{nextTitle.zh && <span data-language="zh">{nextTitle.zh}</span>}</strong></a>}</div>
    </nav>
  </article>
  <script>
    const article = document.querySelector<HTMLElement>("[data-book][data-unit]");
    if (article) {
      const positionKey = `oceanai-reading:${article.dataset.book}`;
      let savedPosition: { unit?: string; scrollY?: number } | undefined;
      try { savedPosition = JSON.parse(localStorage.getItem(positionKey) ?? "null") ?? undefined; } catch {}
      const savedScrollY = savedPosition?.scrollY;
      if (savedPosition?.unit === article.dataset.unit && savedScrollY && !location.hash) scrollTo(0, savedScrollY);
      let savePending = false;
      const savePosition = () => {
        localStorage.setItem(positionKey, JSON.stringify({ unit: article.dataset.unit, path: location.pathname, scrollY, updatedAt: Date.now() }));
        savePending = false;
      };
      savePosition();
      addEventListener("scroll", () => {
        if (!savePending) { savePending = true; requestAnimationFrame(savePosition); }
      }, { passive: true });

      const prefix = `WS-${(article.dataset.unit ?? "TEXT").replace("chapter-", "CH").replace("part-", "PART").toUpperCase()}`;
      const hashText = (value: string) => {
        let hash = 2166136261;
        for (const character of value) {
          hash ^= character.codePointAt(0) ?? 0;
          hash = Math.imul(hash, 16777619);
        }
        return (hash >>> 0).toString(36).toUpperCase().padStart(7, "0").slice(0, 7);
      };
      article.querySelectorAll<HTMLElement>(".prose :is(p, h2, h3, blockquote)").forEach((block) => {
        const text = block.textContent?.trim();
        if (!text || block.closest(".footnotes")) return;
        const thoughtId = `${prefix}-${hashText(text)}`;
        block.id = thoughtId;
        block.classList.add("thought-block");
        const anchor = document.createElement("a");
        anchor.className = "thought-anchor";
        anchor.href = `#${thoughtId}`;
        anchor.textContent = `{#${thoughtId.replace(/^WS-/, "")}}`;
        anchor.setAttribute("aria-label", `Link to thought ${thoughtId}`);
        block.append(anchor);
      });
    }
  </script>
</BaseLayout>
