---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getBookManifests, getBookUnits, type BookManifest } from "../../../lib/book";

export function getStaticPaths() {
  return getBookManifests().map((book) => ({ params: { book: book.slug }, props: { book } }));
}

interface Props { book: BookManifest }
const { book } = Astro.props;
const units = getBookUnits(book.slug);
const groups = Object.entries(Object.groupBy(units, (unit) => unit.part));
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<BaseLayout title={`目錄｜${book.title}`} description={`${book.title}完整線上閱讀目錄。`}>
  <section class="contents shell">
    <nav class="breadcrumbs" aria-label="麵包屑"><a href={`${base}/books/${book.slug}/`}>{book.title}</a><span>/</span><span aria-current="page">目錄</span></nav>
    <header><p class="eyebrow">TABLE OF CONTENTS</p><h1>目錄</h1><p>{units.length} 個閱讀單元</p></header>
    {groups.map(([part, items]) => (
      <section class="contents-group">
        <h2>{part}</h2>
        <ol>
          {items?.map((unit) => (
            <li><a href={`${base}/books/${book.slug}/read/${unit.slug}/`}><span>{unit.label}</span><strong>{unit.title}</strong><small>{unit.minutes} 分鐘</small></a></li>
          ))}
        </ol>
      </section>
    ))}
  </section>
</BaseLayout>
