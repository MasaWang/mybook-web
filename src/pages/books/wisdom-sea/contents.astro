---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getBook } from "../../../lib/book";
const units = getBook();
const groups = Object.entries(Object.groupBy(units, (unit) => unit.part));
---
<BaseLayout title="目錄｜智慧之海" description="《智慧之海》完整線上閱讀目錄。">
  <section class="contents shell">
    <nav class="breadcrumbs" aria-label="麵包屑"><a href="/books/wisdom-sea/">智慧之海</a><span>/</span><span aria-current="page">目錄</span></nav>
    <header><p class="eyebrow">TABLE OF CONTENTS</p><h1>目錄</h1><p>{units.length} 個閱讀單元</p></header>
    {groups.map(([part, items]) => (
      <section class="contents-group">
        <h2>{part}</h2>
        <ol>
          {items?.map((unit) => (
            <li><a href={`/books/wisdom-sea/read/${unit.slug}/`}><span>{unit.label}</span><strong>{unit.title}</strong><small>{unit.minutes} 分鐘</small></a></li>
          ))}
        </ol>
      </section>
    ))}
  </section>
</BaseLayout>
