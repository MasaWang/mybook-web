---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { getBook, type ReadingUnit } from "../../../../lib/book";
export function getStaticPaths() {
  return getBook().map((unit, index, all) => ({ params: { slug: unit.slug }, props: { unit, previous: all[index - 1], next: all[index + 1], index, total: all.length } }));
}
interface Props { unit: ReadingUnit; previous?: ReadingUnit; next?: ReadingUnit; index: number; total: number; }
const { unit, previous, next, index, total } = Astro.props;
---
<BaseLayout title={`${unit.title}｜智慧之海`} description={`《智慧之海》${unit.part}：${unit.title}`}>
  <article class="reader shell" data-book="wisdom-sea" data-unit={unit.slug}>
    <nav class="breadcrumbs" aria-label="麵包屑"><a href="/books/wisdom-sea/">智慧之海</a><span>/</span><a href="/books/wisdom-sea/contents/">目錄</a><span>/</span><span aria-current="page">{unit.title}</span></nav>
    <header class="reader-header">
      <p class="eyebrow">{unit.part} · 約 {unit.minutes} 分鐘</p>
      <h1>{unit.title}</h1>
      <p class="source-note">來源檔案：{unit.sourcePath}</p>
    </header>
    <div class="reading-progress" aria-label={`閱讀單元 ${index + 1}，共 ${total} 個`}><span style={`width:${((index + 1) / total) * 100}%`}></span></div>
    <div class="prose" set:html={unit.html} />
    <nav class="chapter-nav" aria-label="章節導覽">
      <div>{previous && <a href={`/books/wisdom-sea/read/${previous.slug}/`}><small>← 上一篇</small><strong>{previous.title}</strong></a>}</div>
      <div>{next && <a href={`/books/wisdom-sea/read/${next.slug}/`}><small>下一篇 →</small><strong>{next.title}</strong></a>}</div>
    </nav>
  </article>
  <script>
    const article = document.querySelector<HTMLElement>("[data-book][data-unit]");
    if (article) {
      const key = `oceanai-reading:${article.dataset.book}`;
      localStorage.setItem(key, JSON.stringify({ unit: article.dataset.unit, path: location.pathname, updatedAt: Date.now() }));
    }
  </script>
</BaseLayout>
