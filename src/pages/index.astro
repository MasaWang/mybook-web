---
import BaseLayout from "../layouts/BaseLayout.astro";
import BookLanding from "../components/BookLanding.astro";
import { getBookManifests, getBookUnits, getSourceRevision, publicationGraph } from "../lib/book";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const books = getBookManifests();
const book = books[0];
const units = book ? getBookUnits(book.slug) : [];
const sourceRevision = book ? getSourceRevision(book.slug) : undefined;
const pageUrl = new URL(`${base}/`, Astro.site).href;
const bookUrl = book ? new URL(`${base}/books/${book.slug}/`, Astro.site).href : pageUrl;
const image = new URL(`${base}/og-default.svg`, Astro.site).href;
const structuredData = book
  ? publicationGraph({
      book,
      bookUrl,
      page: {
        name: `${book.title} — OceanAI Raw Markdown`,
        description: book.description,
        url: pageUrl,
      },
      image,
    })
  : undefined;
---
<BaseLayout
  title={book ? `${book.title} — OceanAI Raw Markdown` : "OceanAI Raw Markdown"}
  description={book?.description ?? "OceanAI 的 Markdown-first 數位出版。"}
  structuredData={structuredData}
>
  {book ? (
    <BookLanding book={book} units={units} sourceRevision={sourceRevision} />
  ) : (
    <section class="legal-page shell">
      <p class="eyebrow">OCEANAI RAW</p>
      <h1>NO SOURCE DOCUMENT</h1>
      <p>尚未找到書籍 manifest。</p>
    </section>
  )}
</BaseLayout>
