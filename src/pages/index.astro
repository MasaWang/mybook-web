---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getBookManifests } from "../lib/book";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const books = getBookManifests();
---
<BaseLayout title="OceanAI Books｜持續出版書庫" description="OceanAI Books is an open continuous-publishing library. OceanAI 的開放式持續出版書庫。">
  <section class="landing shell">
    <header class="library-intro">
      <p class="eyebrow"><span data-language="en">LIBRARY HOME</span><span data-language="zh">出版庫首頁</span> · OAB-001</p>
      <h1><span>OceanAI Books</span><span data-language="en">Continuous Publishing Library</span><span data-language="zh">持續出版書庫</span></h1>
      <p class="lede"><span data-language="en">Write in GitHub. Publish continuously on the Web.</span><span data-language="zh">在 GitHub 持續撰寫，在 Web 持續出版。</span></p>
    </header>
    <div class="library-list" aria-label="目前書目">
      <p class="library-label"><span data-language="en">CURRENT BOOKS</span><span data-language="zh">目前書目</span></p>
      {books.map((book) => (
        <article class="library-entry">
          <span class="library-number">01.</span>
          <div class="library-title">
            <h2><a href={`${base}/books/${book.slug}/`}><span lang="en" data-language="en">{book.titleEn}</span><span lang="zh-Hant" data-language="zh">{book.title}</span></a></h2>
            <span>{book.author}</span>
            <span>OceanAI</span>
          </div>
          <dl class="library-meta">
            <div><dt><span data-language="en">STATUS</span><span data-language="zh">狀態</span></dt><dd><span data-language="en">{book.publication.statusLabelEn}</span><span data-language="zh">{book.publication.statusLabel}</span></dd></div>
            <div><dt><span data-language="en">UPDATED</span><span data-language="zh">更新</span></dt><dd>{book.publication.updated}</dd></div>
            <div><dt><span data-language="en">LANGUAGE</span><span data-language="zh">語言</span></dt><dd>{book.languageLabel}</dd></div>
          </dl>
          <div class="library-actions">
            <a href={`${base}/books/${book.slug}/read/preface/`}><span data-language="en">▶ START READING</span><span data-language="zh">▶ 開始閱讀</span></a>
            <a href={`${base}/books/${book.slug}/contents/`}><span data-language="en">▶ CONTENTS</span><span data-language="zh">▶ 本書目錄</span></a>
            <a href={`${base}/books/${book.slug}/read/preface/`} data-continue-book={book.slug} hidden><span data-language="en">▶ CONTINUE READING</span><span data-language="zh">▶ 繼續閱讀</span></a>
          </div>
        </article>
      ))}
    </div>
    <p class="library-principles"><span data-language="en">Open · Transparent · Long-term<br />Continuous Publishing</span><span data-language="zh">開放 · 透明 · 長期<br />持續出版</span></p>
  </section>
</BaseLayout>
