---
import "../styles/global.css";
import { getBookManifests } from "../lib/book";
import { Check, Globe2, Moon, Sun } from "lucide-astro";
interface Props {
  title: string;
  description: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  alternateLanguages?: { hrefLang: string; href: string }[];
}
const { title, description, structuredData, alternateLanguages = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const books = getBookManifests();
const socialImage = new URL(`${base}/og-default.svg`, Astro.site);
const jsonLd = structuredData ? JSON.stringify(structuredData).replace(/</g, "\\u003c") : undefined;
---
<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="book" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {alternateLanguages.map((alternate) => <link rel="alternate" hreflang={alternate.hrefLang} href={new URL(alternate.href, canonical)} />)}
    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
    <script is:inline>
      (() => {
        try {
          const savedTheme = localStorage.getItem("oceanai-theme");
          const prefersDark = matchMedia("(prefers-color-scheme: dark)").matches;
          document.documentElement.dataset.theme = savedTheme === "dark" || (!savedTheme && prefersDark) ? "dark" : "light";
        } catch {
          document.documentElement.dataset.theme = "light";
        }
        const supportedModes = new Set(["en", "zh", "bilingual"]);
        const requestedMode = new URLSearchParams(location.search).get("lang");
        let savedMode = null;
        try { savedMode = localStorage.getItem("oceanai-language"); } catch {}
        const mode = requestedMode && supportedModes.has(requestedMode)
          ? requestedMode
          : savedMode && supportedModes.has(savedMode) ? savedMode : "bilingual";
        document.documentElement.dataset.readingMode = mode;
        document.documentElement.lang = mode === "en" ? "en" : "zh-Hant";
      })();
    </script>
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content"><span data-language="en">Skip to content</span><span data-language="zh">跳至主要內容</span></a>
    <header class="site-header shell">
      <a class="brand" href={`${base}/`}>OceanAI Books</a>
      <nav aria-label="主要導覽">
        {books.map((book) => <a href={`${base}/books/${book.slug}/`} aria-current={Astro.url.pathname.includes(`/books/${book.slug}/`) ? "page" : undefined}><span data-language="en">{book.titleEn}</span><span class="bilingual-separator" aria-hidden="true"> / </span><span data-language="zh">{book.title.startsWith("OceanAI") ? <><span class="book-title-latin">OceanAI</span>{book.title.slice("OceanAI".length)}</> : book.title}</span></a>)}
        <div class="language-menu">
          <button class="language-trigger" type="button" aria-label="Language / 閱讀語言" aria-haspopup="listbox" aria-expanded="false">
            <Globe2 size={20} strokeWidth={1.5} aria-hidden="true" />
          </button>
          <div class="language-menu-panel" role="listbox" aria-label="Language / 閱讀語言" hidden>
            <button type="button" role="option" data-language-mode="en" aria-selected="false"><span class="language-option-label"><span lang="en">English</span></span><Check size={16} strokeWidth={1.75} aria-hidden="true" /></button>
            <button type="button" role="option" data-language-mode="zh" aria-selected="false"><span class="language-option-label"><span lang="en">Chinese (TW)</span></span><Check size={16} strokeWidth={1.75} aria-hidden="true" /></button>
            <button type="button" role="option" data-language-mode="bilingual" aria-selected="false"><span class="language-option-label"><span lang="en">English</span><span class="language-option-separator" aria-hidden="true">+</span><span lang="en">Chinese (TW)</span></span><Check size={16} strokeWidth={1.75} aria-hidden="true" /></button>
          </div>
        </div>
        <button class="theme-toggle" type="button" aria-label="切換至深色模式">
          <Moon class="theme-icon theme-icon-moon" size={20} strokeWidth={1.5} aria-hidden="true" />
          <Sun class="theme-icon theme-icon-sun" size={20} strokeWidth={1.5} aria-hidden="true" />
        </button>
      </nav>
    </header>
    <main id="main-content" tabindex="-1"><slot /></main>
    <footer class="site-footer shell">
      <hr class="ascii-rule" />
      <div class="footer-grid">
        <p>
          <strong>OceanAI Books</strong>
          <span data-language="en">RAW DIGITAL EDITION</span>
          <span data-language="zh">原始數位版本</span>
          <span>© 2026 MASA WANG</span>
        </p>
        <p>
          <strong><span data-language="en">WRITE IN GITHUB.</span><span data-language="zh">在 GITHUB 撰寫。</span></strong>
          <span data-language="en">PUBLISH CONTINUOUSLY ON THE WEB.</span>
          <span data-language="zh">在 GitHub 持續撰寫，在 Web 持續出版。</span>
        </p>
        <nav aria-label="頁尾導覽">
          <a href={`${base}/`}><span data-language="en">LIBRARY</span><span data-language="zh">出版庫</span></a>
          <a href="#main-content"><span data-language="en">BACK TO TOP</span><span data-language="zh">返回頂部</span></a>
          <a href="https://github.com/MasaWang/MYBOOK"><span data-language="en">GITHUB / SOURCE MANUSCRIPT</span><span data-language="zh">GITHUB / 原始書稿</span></a>
        </nav>
      </div>
      <div class="footer-note">
        <p>© 2026 MASA WANG — OceanAI Books</p>
        <p data-language="en">CONTINUOUS PUBLICATION — Open · Transparent · Long-term.</p>
        <p data-language="zh">持續出版——開放、透明、長期。</p>
        <p data-language="en">This library preserves the manuscript's ongoing revisions; the public edition follows the update date shown on this website.</p>
        <p data-language="zh">本出版庫保留書稿持續修訂的痕跡；公開版本以網站所示更新日期為準。</p>
      </div>
    </footer>
    <script>
      const themeToggle = document.querySelector<HTMLButtonElement>(".theme-toggle");
      const updateThemeToggle = () => {
        if (!themeToggle) return;
        const dark = document.documentElement.dataset.theme === "dark";
        themeToggle.setAttribute("aria-label", dark ? "Switch to light mode / 切換至淺色模式" : "Switch to dark mode / 切換至深色模式");
        themeToggle.setAttribute("aria-pressed", String(dark));
      };
      updateThemeToggle();
      themeToggle?.addEventListener("click", () => {
        const nextTheme = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = nextTheme;
        try { localStorage.setItem("oceanai-theme", nextTheme); } catch {}
        updateThemeToggle();
      });
      const languageMenu = document.querySelector<HTMLElement>(".language-menu");
      const languageTrigger = document.querySelector<HTMLButtonElement>(".language-trigger");
      const languagePanel = document.querySelector<HTMLElement>(".language-menu-panel");
      const languageOptions = [...document.querySelectorAll<HTMLButtonElement>("[data-language-mode]")];
      const closeLanguageMenu = () => {
        if (!languageTrigger || !languagePanel) return;
        languageTrigger.setAttribute("aria-expanded", "false");
        languagePanel.hidden = true;
      };
      const setLanguageMode = (mode: string) => {
        if (!new Set(["en", "zh", "bilingual"]).has(mode)) return;
        document.documentElement.dataset.readingMode = mode;
        document.documentElement.lang = mode === "en" ? "en" : "zh-Hant";
        languageOptions.forEach((option) => option.setAttribute("aria-selected", String(option.dataset.languageMode === mode)));
        try { localStorage.setItem("oceanai-language", mode); } catch {}
        updateThemeToggle();
        dispatchEvent(new CustomEvent("oceanai:languagechange", { detail: { mode } }));
      };
      setLanguageMode(document.documentElement.dataset.readingMode ?? "bilingual");
      languageTrigger?.addEventListener("click", () => {
        if (!languagePanel) return;
        const open = languageTrigger.getAttribute("aria-expanded") === "true";
        languageTrigger.setAttribute("aria-expanded", String(!open));
        languagePanel.hidden = open;
        if (!open) languageOptions.find((option) => option.getAttribute("aria-selected") === "true")?.focus();
      });
      languageOptions.forEach((option) => option.addEventListener("click", () => {
        setLanguageMode(option.dataset.languageMode ?? "bilingual");
        closeLanguageMenu();
        languageTrigger?.focus();
      }));
      document.addEventListener("click", (event) => {
        if (languageMenu && !languageMenu.contains(event.target as Node)) closeLanguageMenu();
      });
      document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape" || languagePanel?.hidden) return;
        closeLanguageMenu();
        languageTrigger?.focus();
      });
      document.querySelectorAll<HTMLAnchorElement>("[data-continue-book]").forEach((link) => {
        const book = link.dataset.continueBook;
        const saved = book ? localStorage.getItem(`oceanai-reading:${book}`) : null;
        if (!saved) return;
        try {
          const position = JSON.parse(saved) as { path?: string };
          if (position.path) {
            link.href = position.path;
            link.hidden = false;
          }
        } catch { localStorage.removeItem(`oceanai-reading:${book}`); }
      });
    </script>
  </body>
</html>
