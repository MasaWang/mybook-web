---
import "../styles/global.css";
import { getBookManifests } from "../lib/book";
interface Props {
  title: string;
  description: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  alternateLanguages?: { hrefLang: string; href: string }[];
}
const { title, description, structuredData, alternateLanguages = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const books = getBookManifests();
const socialImage = new URL(`${base}/og-default.svg`, Astro.site);
const jsonLd = structuredData ? JSON.stringify(structuredData).replace(/</g, "\\u003c") : undefined;
---
<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="book" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {alternateLanguages.map((alternate) => <link rel="alternate" hreflang={alternate.hrefLang} href={new URL(alternate.href, canonical)} />)}
    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
    <script is:inline>
      (() => {
        try {
          const savedTheme = localStorage.getItem("oceanai-theme");
          const prefersDark = matchMedia("(prefers-color-scheme: dark)").matches;
          document.documentElement.dataset.theme = savedTheme === "dark" || (!savedTheme && prefersDark) ? "dark" : "light";
        } catch {
          document.documentElement.dataset.theme = "light";
        }
      })();
    </script>
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳至主要內容</a>
    <header class="site-header shell">
      <a class="brand" href={`${base}/`}>OCEANAI <span>BOOKS</span></a>
      <nav aria-label="主要導覽">
        {books.map((book) => <a href={`${base}/books/${book.slug}/`} aria-current={Astro.url.pathname.includes(`/books/${book.slug}/`) ? "page" : undefined}>{book.title}</a>)}
        <button class="theme-toggle" type="button" aria-label="切換至深色模式">深色</button>
      </nav>
    </header>
    <main id="main-content" tabindex="-1"><slot /></main>
    <footer class="site-footer shell">
      <p>OceanAI 是系統級智慧架構。</p>
      <p>內容來源：MYBOOK · Markdown-first publishing</p>
    </footer>
    <script>
      const themeToggle = document.querySelector<HTMLButtonElement>(".theme-toggle");
      const updateThemeToggle = () => {
        if (!themeToggle) return;
        const dark = document.documentElement.dataset.theme === "dark";
        themeToggle.textContent = dark ? "淺色" : "深色";
        themeToggle.setAttribute("aria-label", dark ? "切換至淺色模式" : "切換至深色模式");
        themeToggle.setAttribute("aria-pressed", String(dark));
      };
      updateThemeToggle();
      themeToggle?.addEventListener("click", () => {
        const nextTheme = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = nextTheme;
        try { localStorage.setItem("oceanai-theme", nextTheme); } catch {}
        updateThemeToggle();
      });
      document.querySelectorAll<HTMLAnchorElement>("[data-continue-book]").forEach((link) => {
        const book = link.dataset.continueBook;
        const saved = book ? localStorage.getItem(`oceanai-reading:${book}`) : null;
        if (!saved) return;
        try {
          const position = JSON.parse(saved) as { path?: string };
          if (position.path) {
            link.href = position.path;
            link.hidden = false;
          }
        } catch { localStorage.removeItem(`oceanai-reading:${book}`); }
      });
    </script>
  </body>
</html>
